{
  "name": "angular-material-datetime",
  "version": "0.0.0",
  "description": "Material 3 datetime and time picker components for Angular 19–22.",
  "author": {
    "name": "Trần Thuận Nghĩa",
    "email": "tran.thuan.nghia@gmail.com",
    "url": "https://github.com/sdcorejs"
  },
  "homepage": "https://sdcorejs.github.io/angular-material-datetime/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdcorejs/angular-material-datetime.git"
  },
  "keywords": [
    "angular",
    "angular-material",
    "material-3",
    "datetime-picker",
    "timepicker"
  ],
  "scripts": {
    "build:datetime": "ng build datetime",
    "build:all": "ng build datetime && ng build moment-adapter && ng build date-fns-adapter",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:package": "node tools/verify-package.mjs",
    "test:package-baseline": "node --test tools/compare-package-baseline.test.mjs && node tools/compare-package-baseline.mjs",
    "test:consumer": "node tools/consumer-smoke.mjs",
    "test:release-workflow": "node --test tools/release-workflow.test.mjs tools/publish-datetime.test.mjs",
    "pack:datetime": "npm pack --dry-run --json ./dist/datetime",
    "lint": "ng lint",
    "ng": "ng",
    "start": "ng serve demo",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run release",
    "version": "changeset version",
    "publish:datetime": "node tools/publish-datetime.mjs",
    "release": "node tools/publish-datetime.mjs && changeset tag"
  },
  "private": true,
  "workspaces": [
    "projects/datetime",
    "projects/moment-adapter",
    "projects/date-fns-adapter"
  ],
  "dependencies": {
    "@angular/animations": "19.2.22",
    "@angular/common": "19.2.22",
    "@angular/compiler": "19.2.22",
    "@angular/core": "19.2.22",
    "@angular/forms": "19.2.22",
    "@angular/platform-browser": "19.2.22",
    "@angular/platform-browser-dynamic": "19.2.22",
    "@angular/router": "19.2.22",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^19.0.1",
    "@angular-devkit/build-angular": "^19.2.26",
    "@angular/cdk": "~19.2.0",
    "@angular/cli": "~19.2.0",
    "@angular/compiler-cli": "19.2.22",
    "@angular/material": "~19.2.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/jest": "^29.5.14",
    "@types/prismjs": "^1.26.6",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.4",
    "ng-packagr": "^19.2.0",
    "prismjs": "^1.30.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.33.1"
  }
}
